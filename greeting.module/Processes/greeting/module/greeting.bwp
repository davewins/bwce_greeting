                                tibex:constructor="onMessageStart" tibex:xpdlId="91aa182b-eb3b-4349-8b58-dfc3e8286910"/>
                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="22f48602-a9c2-4992-8619-cdabb8069d68"/>
                            <bpws:reply name="getOut" operation="get"
                                partnerLink="greeting"
                                portType="ns:greeting"
                                tibex:xpdlId="44078490-9fa4-4633-9e26-5b29f3a12fb8" variable="getOut-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20181108164012PLT&quot; xmlns:tns1=&quot;http://xmlns.example.com/greeting/parameters&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;item>&#xa;            &lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;!DOCTYPE html>&amp;lt;html>&amp;lt;head>&amp;lt;meta charset='UTF-8'>&amp;lt;link rel='icon' href='data:,'>&amp;lt;title>BW Status&amp;lt;/title>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;style>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;body{font-family:Segoe UI,Arial,sans-serif;background:#f4f6f9;display:flex;justify-content:center;padding-top:60px;margin:0}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;.card{background:#fff;border-radius:10px;box-shadow:0 2px 12px rgba(0,0,0,.12);padding:28px 36px;min-width:360px}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;h1{margin:0 0 18px;font-size:22px;color:#1a3d6d}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;table{border-collapse:collapse;width:100%}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;td{padding:8px 4px;border-bottom:1px solid #eee;font-size:15px}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;td.k{color:#666;width:40%}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;td.v{font-weight:600;color:#222}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;/style>&amp;lt;/head>&amp;lt;body>&amp;lt;div class='card'>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;h1>Hello &amp;quot;, translate($get.parameters/tns1:name, &amp;quot;&amp;lt;>&amp;amp;&amp;quot;, &amp;quot;&amp;quot;), &amp;quot;&amp;lt;/h1>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;table>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;tr>&amp;lt;td class='k'>Host&amp;lt;/td>&amp;lt;td class='v'>&amp;quot;, bw:getHostName(), &amp;quot;&amp;lt;/td>&amp;lt;/tr>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;tr>&amp;lt;td class='k'>BW Version&amp;lt;/td>&amp;lt;td class='v'>&amp;quot;, bw:getSystemProperty(&amp;quot;BW.VERSION&amp;quot;), &amp;quot;&amp;lt;/td>&amp;lt;/tr>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;tr>&amp;lt;td class='k'>App Version&amp;lt;/td>&amp;lt;td class='v'>&amp;quot;, &amp;#xD;&amp;#xA;   if (string-length(bw:getSystemProperty(&amp;quot;BW.APPLICATION.VERSION&amp;quot;)) > 0) &amp;#xD;&amp;#xA;   then bw:getSystemProperty(&amp;quot;BW.APPLICATION.VERSION&amp;quot;) &amp;#xD;&amp;#xA;   else &amp;quot;Local / Development&amp;quot;, &amp;#xD;&amp;#xA; &amp;quot;&amp;lt;/td>&amp;lt;/tr>&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;/table>&amp;lt;/div>&amp;lt;/body>&amp;lt;/html>&amp;quot;&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&quot;/>&#xa;        &lt;/item>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20181108164012PLT&quot; xmlns:tns1=&quot;http://xmlns.example.com/greeting/parameters&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:httpResponseHeaders>&#xa;            &lt;Content-Type>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;text/html; charset=UTF-8&amp;quot;&quot;/>&#xa;            &lt;/Content-Type>&#xa;        &lt;/tns3:httpResponseHeaders>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20181108164012PLT" xmlns:tns1="http://xmlns.example.com/greeting/parameters" xmlns:tns3="http://tns.tibco.com/bw/REST" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" version="2.0"&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns:getResponse&gt;&lt;item&gt;&lt;xsl:value-of select="concat(&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;!DOCTYPE html&gt;&amp;lt;html&gt;&amp;lt;head&gt;&amp;lt;meta charset='UTF-8'&gt;&amp;lt;link rel='icon' href='data:,'&gt;&amp;lt;title&gt;BW Status&amp;lt;/title&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;style&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;body{font-family:Segoe UI,Arial,sans-serif;background:#f4f6f9;display:flex;justify-content:center;padding-top:60px;margin:0}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;.card{background:#fff;border-radius:10px;box-shadow:0 2px 12px rgba(0,0,0,.12);padding:28px 36px;min-width:360px}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;h1{margin:0 0 18px;font-size:22px;color:#1a3d6d}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;table{border-collapse:collapse;width:100%}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;td{padding:8px 4px;border-bottom:1px solid #eee;font-size:15px}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;td.k{color:#666;width:40%}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;td.v{font-weight:600;color:#222}&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;/style&gt;&amp;lt;/head&gt;&amp;lt;body&gt;&amp;lt;div class='card'&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;h1&gt;Hello &amp;quot;, translate($get/parameters/tns1:greetingGetParameters/tns1:name, &amp;quot;&amp;lt;&gt;&amp;amp;&amp;quot;, &amp;quot;&amp;quot;), &amp;quot;&amp;lt;/h1&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;table&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;tr&gt;&amp;lt;td class='k'&gt;Host&amp;lt;/td&gt;&amp;lt;td class='v'&gt;&amp;quot;, bw:getHostName(), &amp;quot;&amp;lt;/td&gt;&amp;lt;/tr&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;tr&gt;&amp;lt;td class='k'&gt;BW Version&amp;lt;/td&gt;&amp;lt;td class='v'&gt;&amp;quot;, bw:getSystemProperty(&amp;quot;BW.VERSION&amp;quot;), &amp;quot;&amp;lt;/td&gt;&amp;lt;/tr&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;tr&gt;&amp;lt;td class='k'&gt;App Version&amp;lt;/td&gt;&amp;lt;td class='v'&gt;&amp;quot;, &amp;#xD;&amp;#xA;   if (string-length(bw:getSystemProperty(&amp;quot;BW.APPLICATION.VERSION&amp;quot;)) &gt; 0) &amp;#xD;&amp;#xA;   then bw:getSystemProperty(&amp;quot;BW.APPLICATION.VERSION&amp;quot;) &amp;#xD;&amp;#xA;   else &amp;quot;Local / Development&amp;quot;, &amp;#xD;&amp;#xA; &amp;quot;&amp;lt;/td&gt;&amp;lt;/tr&gt;&amp;quot;,&amp;#xD;&amp;#xA; &amp;quot;&amp;lt;/table&gt;&amp;lt;/div&gt;&amp;lt;/body&gt;&amp;lt;/html&gt;&amp;quot;&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;"/&gt;&lt;/item&gt;&lt;httpResponseHeaders&gt;&lt;tns3:httpResponseHeaders&gt;&lt;Content-Type&gt;&lt;xsl:value-of select="&amp;quot;text/html; charset=UTF-8&amp;quot;"/&gt;&lt;/Content-Type&gt;&lt;/tns3:httpResponseHeaders&gt;&lt;/httpResponseHeaders&gt;&lt;/tns:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="LogTogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/greeting/parameters&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(bw:getHostName(),&amp;quot; Received a greeting for &amp;quot;,$get/parameters/tns1:greetingGetParameters/tns1:name)&quot;/>&lt;/message>&lt;/tns2:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Log-input" name="Log"
                                    tibex:xpdlId="70bd4999-7529-4ca5-929f-3956306de37a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogTogetOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/greeting/parameters&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(bw:getHostName(),&amp;quot; Received a greeting for &amp;quot;,$get.parameters/tns1:name)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
